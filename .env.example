# Copy to .env and fill in the Clerk keys (https://dashboard.clerk.com → API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Local services (defaults work with docker compose)
POSTGRES_USER=vault
POSTGRES_PASSWORD=vault
POSTGRES_DB=vault
S3_ACCESS_KEY=vaultadmin
S3_SECRET_KEY=vaultsecret
S3_BUCKET=medical-vault

# AI providers (free tiers). Use only synthetic or your own documents: Gemini's free tier
# may use prompts to improve Google's products.
GEMINI_API_KEY=        # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.5-flash
# Tried in order when the main model is overloaded (503) or rate limited (429).
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.1-flash-lite
# Model for interactive "Ask" answers (fast); falls back to the models above.
GEMINI_ASK_MODEL=gemini-3.1-flash-lite
VOYAGE_API_KEY=        # https://dashboard.voyageai.com
